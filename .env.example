# ==============================================================================
# TenantEase AI Engine — Environment Configuration (.env.example)
# Copy this file to .env and adjust variables for your target deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Server port. Cloud Run, Render, and Railway automatically inject the PORT environment variable.
PORT=8000

# Host binding IP (0.0.0.0 binds to all network interfaces for container deployments)
HOST=0.0.0.0

# Deployment environment: 'development', 'staging', or 'production'
ENVIRONMENT=production

# Application logging level: 'debug', 'info', 'warning', 'error'
LOG_LEVEL=info

# Permitted CORS origins for API requests (comma-separated list, or '*' for public access)
# In production, set to your frontend domain: e.g. https://tenantease.cynbit.in
CORS_ORIGINS=*

# Container process mode when using the unified Docker container:
# 'api'       -> Launches FastAPI REST microservice (uvicorn api:app)
# 'dashboard' -> Launches interactive Streamlit dashboard (streamlit run app.py)
APP_MODE=api


# ------------------------------------------------------------------------------
# 2. AI / LLM GENERATIVE CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
# By default, TenantEase AI operates in local deterministic mode (zero token cost)
# using Okapi BM25 + TF-IDF Cosine Retrieval + deterministic regex lease extraction.
#
# To enable generative LLM answer synthesis and LLM fallback extraction,
# supply an OpenAI or LiteLLM compatible API key below:
OPENAI_API_KEY=

# Target LLM model name for synthesis and extraction fallback
OPENAI_MODEL=gpt-4o-mini

# Sampling temperature for LLM generation (0.0 enforces strict factual adherence to citations)
LLM_TEMPERATURE=0.0


# ------------------------------------------------------------------------------
# 3. BUSINESS LOGIC, HITL GOVERNANCE & FILE STORAGE
# ------------------------------------------------------------------------------
# Human-in-the-Loop cost threshold in INR (Clause 5.3).
# Any maintenance order exceeding this amount triggers an approval gate.
HITL_COST_THRESHOLD_INR=5000.0

# Minimum document extraction confidence threshold before flagging HITL review
EXTRACTION_CONFIDENCE_THRESHOLD=0.85

# Directory path for lease agreement PDFs
DATA_DIR=./data/sample_leases

# Directory path for generated benchmarks and scored portfolio CSVs
OUTPUTS_DIR=./outputs


# ------------------------------------------------------------------------------
# 4. STREAMLIT OPERATOR DASHBOARD SETTINGS
# ------------------------------------------------------------------------------
# Streamlit web server listening port (default 8501)
STREAMLIT_SERVER_PORT=8501

# Streamlit bind address
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Run Streamlit in headless server mode (required in Docker / production)
STREAMLIT_SERVER_HEADLESS=true
